# Production Environment Variables
# Copy this file to .env.production and fill in your actual values
# For Vercel: Set these in Project Settings → Environment Variables

# === REQUIRED FOR CORE FUNCTIONALITY ===

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# === OPTIONAL FEATURES ===

# Shopify Storefront (for e-commerce)
VITE_SHOPIFY_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your-storefront-token-here

# Radio Streaming (for radio page)
VITE_RADIOKING_BASE=https://api.radioking.io
VITE_RADIOKING_SLUG=your-radio-slug
VITE_AZURACAST_API_BASE=https://your-azuracast-instance.com
VITE_AZURACAST_API_KEY=your-azuracast-api-key

# Telegram Bot (for notifications)
VITE_TELEGRAM_BOT_TOKEN=your-bot-token-here
VITE_TELEGRAM_MOD_CHAT_ID=your-telegram-chat-id

# Webhooks (for Make.com integrations)
VITE_WEBHOOK_SECRET=your-webhook-secret
VITE_MAKE_WEBHOOK_CARE=https://hook.make.com/your-care-webhook
VITE_MAKE_WEBHOOK_EARN=https://hook.make.com/your-earn-webhook

# Analytics (for tracking)
VITE_ANALYTICS_ID=your-analytics-id

# Weather API (public, no auth required)
VITE_WEATHER_API_BASE=https://api.open-meteo.com

# Link Signing (for HMAC verification)
VITE_LINK_SIGNING_SECRET=your-hmac-secret-key

# === NOTES ===
# - All VITE_ prefixed variables are exposed to the client
# - Never commit real credentials to git
# - Use Vercel/Netlify dashboards to set these in production
# - Mock values are fine for development/testing
